{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/wherewasi/save.mjs mark",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/wherewasi/save.mjs check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
